# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=o2c

# OpenRouter LLM
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Backend
CORS_ORIGINS=*
LLM_RATE_LIMIT=10
POOL_MIN_SIZE=5
POOL_MAX_SIZE=20
